ARG BASE_IMAGE=registry.ddbuild.io/images/base/gbi-ubuntu_2404-fips:release
ARG BUILDER_IMAGE=registry.ddbuild.io/compute-delivery/go:latest
ARG BUILD_ARGS=GOFIPS140=v1.0.0
ARG JUICEFS_REPO_URL=https://github.com/DataDog/juicefs
ARG JUICEFS_REPO_BRANCH=v1.4.2-dd
ARG JUICEFS_REPO_REF=46af7afa9f819b8c9ddafd475fb828d22fe9dd17

FROM --platform=$BUILDPLATFORM $BUILDER_IMAGE AS binaryimage
ARG BUILD_ARGS
ARG GOPROXY
ARG TARGETARCH
ARG JUICEFS_REPO_URL
ARG JUICEFS_REPO_BRANCH
ARG JUICEFS_REPO_REF

WORKDIR /workspace
ENV GOPROXY=${GOPROXY:-https://proxy.golang.org}
RUN apt-get update && apt-get install -y musl-tools upx-ucl && \
    git clone --branch="${JUICEFS_REPO_BRANCH}" "${JUICEFS_REPO_URL}" juicefs && \
    cd juicefs && \
    git checkout --detach "${JUICEFS_REPO_REF}" && \
    test "$(git rev-parse HEAD)" = "${JUICEFS_REPO_REF}" && \
    env ${BUILD_ARGS} make juicefs && \
    go version -m juicefs | grep -F 'GOFIPS140=v1.0.0' && \
    mv juicefs /usr/local/bin/juicefs

FROM $BASE_IMAGE
ARG JUICEFS_REPO_REF
ARG TARGETARCH

LABEL com.datadoghq.juicefs.revision="${JUICEFS_REPO_REF}"

COPY --from=binaryimage /usr/local/bin/juicefs /usr/local/bin/juicefs
USER root
RUN clean-apt install -y wget fuse3 gnupg2 curl procps iputils-ping strace iproute2 net-tools tcpdump lsof openssh-server openssh-client
RUN mkdir /var/run/sshd
RUN ln -s /usr/local/bin/juicefs /bin/mount.juicefs && \
    /usr/local/bin/juicefs --version

ENV K8S_VERSION=v1.14.8
RUN curl -o /usr/local/bin/kubectl https://storage.googleapis.com/kubernetes-release/release/${K8S_VERSION}/bin/linux/${TARGETARCH}/kubectl && \
    chmod +x /usr/local/bin/kubectl

USER dog
